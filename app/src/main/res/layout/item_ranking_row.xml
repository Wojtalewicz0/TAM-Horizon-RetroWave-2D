<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="194px"
    android:layout_marginBottom="5px"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ranking_row_number"
            style="@style/RankingRowText"
            android:layout_width="160px"
            android:layout_height="match_parent" />

        <com.example.horizonretrowave.CircleImageView
            android:id="@+id/ranking_row_image"
            android:layout_width="190px"
            android:layout_height="190px"
            android:contentDescription="@string/rankings_player_photo_description"
            android:scaleType="centerCrop"
            android:src="@drawable/main_profile" />

        <TextView
            android:id="@+id/ranking_row_name"
            style="@style/RankingRowText"
            android:layout_width="660px"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:paddingStart="28px"
            android:textSize="52px" />

        <TextView
            android:id="@+id/ranking_row_divider"
            style="@style/RankingRowText"
            android:layout_width="70px"
            android:layout_height="match_parent"
            android:text="|"
            android:textSize="160px" />

        <TextView
            android:id="@+id/ranking_row_points"
            style="@style/RankingRowText"
            android:layout_width="240px"
            android:layout_height="match_parent" />
    </LinearLayout>
</FrameLayout>
