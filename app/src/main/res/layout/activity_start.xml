<?xml version="1.0" encoding="utf-8"?>
<com.example.horizonretrowave.SceneHost xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/start_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".StartActivity">

    <!-- Lowest layer of the profile screen. It is revealed after the warning. -->
    <TextureView
        android:id="@+id/profile_video_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.15"
        android:clickable="false"
        android:contentDescription="@null"
        android:focusable="false"
        android:visibility="gone"
        app:scene_center_x="960"
        app:scene_center_y="540"
        app:scene_height="1080"
        app:scene_width="1920" />

    <!-- Profile creation content. It uses the global main.ttf theme font. -->
    <LinearLayout
        android:id="@+id/profile_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:scene_center_x="960"
        app:scene_center_y="540"
        app:scene_height="1000"
        app:scene_width="1760">

        <TextView
            android:id="@+id/profile_title"
            android:layout_width="match_parent"
            android:layout_height="110px"
            android:gravity="center"
            android:includeFontPadding="false"
            android:shadowColor="@color/profile_neon_pink_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="44"
            android:text="@string/create_profile"
            android:textColor="@android:color/white"
            android:textSize="84px"
            android:translationY="-44px" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="720px"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="760px"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <com.example.horizonretrowave.CircleImageView
                    android:id="@+id/profile_image"
                    android:layout_width="540px"
                    android:layout_height="540px"
                    android:contentDescription="@string/profile_image_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/main_profile" />

                <Button
                    android:id="@+id/change_profile_button"
                    android:layout_width="550px"
                    android:layout_height="124px"
                    android:layout_marginTop="30px"
                    android:background="@drawable/profile_button_background"
                    android:backgroundTint="@null"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minHeight="0px"
                    android:minWidth="0px"
                    android:paddingTop="0px"
                    android:paddingBottom="0px"
                    app:backgroundTint="@null"
                    android:shadowColor="@color/profile_neon_pink_glow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="24"
                    android:text="@string/change_profile"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="44px" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="760px"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/profile_nick"
                    android:layout_width="720px"
                    android:layout_height="130px"
                    android:background="@drawable/profile_input_background"
                    android:gravity="center"
                    android:hint="@string/profile_nick_hint"
                    android:includeFontPadding="false"
                    android:inputType="textCapSentences"
                    android:maxLength="25"
                    android:paddingStart="28px"
                    android:paddingEnd="28px"
                    android:paddingTop="0px"
                    android:paddingBottom="0px"
                    android:singleLine="true"
                    android:shadowColor="@color/profile_neon_pink_glow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="24"
                    android:textColor="@android:color/white"
                    android:textColorHint="#CCFFFFFF"
                    android:textSize="46px" />

                <Button
                    android:id="@+id/play_button"
                    android:layout_width="720px"
                    android:layout_height="170px"
                    android:layout_marginTop="90px"
                    android:background="@drawable/profile_button_background"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minHeight="0px"
                    android:minWidth="0px"
                    android:paddingTop="0px"
                    android:paddingBottom="0px"
                    android:shadowColor="@color/profile_neon_pink_glow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="24"
                    android:text="@string/play_button"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="62px" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!--
        Compact, centered epilepsy warning. The whole container is faded as
        one element by StartActivity.startAppSequence().
    -->
    <LinearLayout
        android:id="@+id/epilepsy_warning"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:elevation="500dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="56px"
        android:paddingTop="32px"
        android:paddingEnd="56px"
        android:paddingBottom="32px"
        android:visibility="gone"
        app:scene_center_x="960"
        app:scene_center_y="540"
        app:scene_height="720"
        app:scene_width="1600">

        <TextView
            android:id="@+id/epilepsy_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/epilepsy_title_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/epilepsy_title"
            android:textColor="@android:color/white"
            android:textSize="58px" />

        <TextView
            android:id="@+id/epilepsy_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28px"
            android:fontFamily="@font/epilepsy_text"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="6px"
            android:text="@string/epilepsy_warning_text"
            android:textColor="@android:color/white"
            android:textSize="25px" />

    </LinearLayout>

    <!-- Highest current UI layer. Shared.BlackFade controls its alpha and hitbox. -->
    <View
        android:id="@+id/black_fade_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:clickable="true"
        android:contentDescription="@null"
        android:elevation="1000dp"
        android:focusable="true"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:scene_center_x="960"
        app:scene_center_y="540"
        app:scene_height="1080"
        app:scene_width="1920" />

</com.example.horizonretrowave.SceneHost>
