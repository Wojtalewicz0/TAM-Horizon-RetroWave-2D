    </style>

    <style name="GameHudResultText">
        <item name="android:fontFamily">@font/main</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFFFDD4A</item>
        <item name="android:textSize">104px</item>
    </style>

    <style name="GameNumpadButton">
        <item name="android:background">@drawable/game_numpad_button_background</item>
